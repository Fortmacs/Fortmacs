# Usage: awk -v baseline=tools/audit-baseline -f tools/audit.awk FILE.f90...
#
# Prints FILE:LINE: RULE: what is wrong, for each finding, and exits
# with status 1 if there is any.  The rules (PORTING.md, "Audit"):
#
#   header  the header of PORTING.md's template: "! FILE -- summary.",
#           the provenance line(s), "!", the upstream copyright lines,
#           "! Copyright (C) 2026 The Fortmacs authors", "!", "! This
#           file is part of Fortmacs.", "!", the GPLv3-or-later notice,
#           then a blank line.  The provenance is "Ported from GNU Emacs
#           31.1 ..." (a ported source), "Ports GNU Emacs 31.1 ..." (a
#           test porting upstream tests), "Own tests; ..." (a test with
#           nothing to port), "Generated by tools/..." (a generated
#           file), or nothing (a new file).  Upstream copyright lines
#           come with "Ported from" and "Ports" and with "Generated by"
#           from GNU Emacs data, and only then.  docs/init.f90, the
#           template users copy, has no header beyond its first lines.
#   name    a file holds the module, submodule or program of its name
#           (app/main.f90, test/main.f90 and docs/init.f90 excepted).
#   suffix  a module or submodule is named with the `_mod' suffix
#           (buffer_mod in buffer_mod.f90), except the API module
#           `fortmacs' (docs/init.f90, with `user_config', is excepted).
#   doc     every public entity a module declares has a `!>' comment
#           right above its declaration.
#   port    in a ported source, every procedure of the module (not the
#           ones contained in procedures) says "Port of ..." or "Not a
#           port" in the comment above it; for a separate module
#           procedure that is the comment of its interface.  Commands'
#           `cmd_' procedures, which only read a command's arguments,
#           are exempt, and so are the FILE:PROCEDURE lines of the
#           baseline file (which may only shrink).

function finding(line, rule, msg) {
    printf "%s:%d: %s: %s\n", file, line, rule, msg
    nfindings++
}

BEGIN {
    n = 0
    gpl[++n] = "! Fortmacs is free software: you can redistribute it and/or modify"
    gpl[++n] = "! it under the terms of the GNU General Public License as published by"
    gpl[++n] = "! the Free Software Foundation, either version 3 of the License, or"
    gpl[++n] = "! (at your option) any later version."
    gpl[++n] = "!"
    gpl[++n] = "! Fortmacs is distributed in the hope that it will be useful,"
    gpl[++n] = "! but WITHOUT ANY WARRANTY; without even the implied warranty of"
    gpl[++n] = "! MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the"
    gpl[++n] = "! GNU General Public License for more details."
    gpl[++n] = "!"
    gpl[++n] = "! You should have received a copy of the GNU General Public License"
    gpl[++n] = "! along with Fortmacs.  If not, see <https://www.gnu.org/licenses/>."
    ngpl = n
    if (baseline != "") {
        while ((getline entry < baseline) > 0) {
            if (entry ~ /^#/ || entry == "") continue
            allowed[entry] = 1
            used[entry] = 0
        }
        close(baseline)
    }
}

FNR == 1 {
    if (NR > 1) check_file()
    nlines = 0
    file = FILENAME
}

{ lines[++nlines] = $0 }

END {
    if (NR > 0) check_file()
    for (entry in allowed) {
        if (!used[entry]) {
            printf "%s: port: no longer needed in the baseline: %s\n", baseline, entry
            nfindings++
        }
    }
    exit nfindings > 0
}

function check_file(    base) {
    base = file
    sub(/.*\//, "", base)
    name = base
    sub(/\.f90$/, "", name)
    nhead = 0
    while (nhead < nlines && lines[nhead + 1] ~ /^!/ && lines[nhead + 1] !~ /^!>/) {
        nhead++
        head[nhead] = lines[nhead]
    }
    provenance = ""
    if (file != "docs/init.f90") check_header(base)
    split_statements()
    check_name()
    check_doc()
    if (provenance == "ported") check_port()
}

# ------------------------------------------------------------------
# header
# ------------------------------------------------------------------

function check_header(base,    i, text, upstream, j, need) {
    i = 1
    if (nhead == 0 || index(head[1], "! " base " -- ") != 1) {
        finding(1, "header", "the first line is not \"! " base " -- summary.\"")
        return
    }
    # The summary, which may wrap, ends with a full stop.
    while (i < nhead && head[i] !~ /\.$/) i++
    i++
    if (head[i] ~ /^! Ported from GNU Emacs 31\.1 /) {
        provenance = "ported"
    } else if (head[i] ~ /^! Ports GNU Emacs 31\.1 /) {
        provenance = "ports"
    } else if (head[i] ~ /^! Own tests; /) {
        provenance = "own"
    } else if (head[i] ~ /^! Generated by tools\//) {
        provenance = "generated"
    } else if (head[i] != "!") {
        finding(i, "header", "expected \"Ported from GNU Emacs 31.1\", \"Ports GNU Emacs 31.1\", \"Own tests;\", \"Generated by tools/\" or \"!\": " head[i])
        return
    }
    text = ""
    if (provenance != "") {
        while (i <= nhead && head[i] != "!") {
            text = text " " head[i]
            i++
        }
        if (text !~ /\.$/) finding(i - 1, "header", "the provenance does not end with a full stop")
    }
    if (head[i] != "!") {
        finding(i, "header", "expected \"!\": " head[i])
        return
    }
    i++
    upstream = 0
    while (i <= nhead && head[i] != "! Copyright (C) 2026 The Fortmacs authors" && head[i] != "!") {
        if (head[i] ~ /^! Copyright \(C\) /) upstream = 1
        i++
    }
    if (head[i] != "! Copyright (C) 2026 The Fortmacs authors") {
        finding(i, "header", "expected \"! Copyright (C) 2026 The Fortmacs authors\": " head[i])
        return
    }
    need = provenance == "ported" || provenance == "ports" || \
           (provenance == "generated" && text ~ /GNU Emacs 31\.1/)
    if (need && !upstream) finding(i, "header", "no upstream copyright notice for what this file ports or is generated from")
    if (!need && upstream) finding(i, "header", "an upstream copyright notice, but the provenance names nothing from upstream")
    i++
    if (head[i] != "!" || head[i + 1] != "! This file is part of Fortmacs." || head[i + 2] != "!") {
        finding(i, "header", "expected \"!\", \"! This file is part of Fortmacs.\", \"!\"")
        return
    }
    i += 3
    for (j = 1; j <= ngpl; j++) {
        if (head[i] != gpl[j]) {
            finding(i, "header", "the GPLv3-or-later notice differs: " head[i])
            return
        }
        i++
    }
    if (i <= nhead) finding(i, "header", "the header goes on after the notice: " head[i])
}

# ------------------------------------------------------------------
# Statements
# ------------------------------------------------------------------

# Split lines[] into statements: stext[k] (lower case, without comments
# and with strings emptied), sline[k] (its first line) and sdoc[k] (the
# comment lines right above it, joined).
function split_statements(    i, line, code, quote, c, j, out, cont, doc) {
    nstmts = 0
    doc = ""
    quote = ""
    cont = 0
    for (i = 1; i <= nlines; i++) {
        line = lines[i]
        if (!cont && line ~ /^[ \t]*!/) {
            doc = doc "\n" line
            continue
        }
        if (!cont && line ~ /^[ \t]*$/) {
            doc = ""
            continue
        }
        if (cont && (line ~ /^[ \t]*!/ || line ~ /^[ \t]*$/)) continue
        out = ""
        if (quote != "") sub(/^[ \t]*&/, "", line)
        for (j = 1; j <= length(line); j++) {
            c = substr(line, j, 1)
            if (quote != "") {
                if (c == quote) {
                    if (substr(line, j + 1, 1) == quote) {
                        j++
                        continue
                    }
                    quote = ""
                    out = out c
                }
                continue
            }
            if (c == "!") break
            if (c == "\"" || c == "'") quote = c
            out = out c
        }
        sub(/[ \t]+$/, "", out)
        if (!cont) {
            nstmts++
            sline[nstmts] = i
            sdoc[nstmts] = doc
            stext[nstmts] = ""
            doc = ""
        } else {
            sub(/^[ \t]*&?[ \t]*/, "", out)
        }
        cont = out ~ /&$/ || quote != ""
        sub(/[ \t]*&$/, "", out)
        stext[nstmts] = stext[nstmts] " " tolower(out)
    }
    for (i = 1; i <= nstmts; i++) {
        sub(/^ +/, "", stext[i])
        gsub(/ +/, " ", stext[i])
    }
}

# ------------------------------------------------------------------
# name
# ------------------------------------------------------------------

function check_name(    k, s, unit) {
    if (file == "app/main.f90" || file == "test/main.f90" || file == "docs/init.f90") return
    for (k = 1; k <= nstmts; k++) {
        s = stext[k]
        if (s ~ /^(module|submodule|program)[ (]/ && s !~ /^module (procedure|subroutine|function)/) {
            unit = s
            sub(/^submodule *\([^)]*\) */, "", unit)
            sub(/^(module|program) +/, "", unit)
            sub(/[ ,(].*/, "", unit)
            if (unit != name) finding(sline[k], "name", "the file holds " unit ", not " name)
            if (s !~ /^program/ && unit != "fortmacs" && unit !~ /_mod$/)
                finding(sline[k], "suffix", "the " (s ~ /^submodule/ ? "submodule " : "module ") unit " is not named with the _mod suffix")
            return
        }
    }
}

# ------------------------------------------------------------------
# doc
# ------------------------------------------------------------------

# The names a statement S declares, in decl[1..], or 0.
function declared(s,    t, m, i, parts, x) {
    if (s ~ /^((recursive|pure|elemental|impure|module|non_recursive) +)*((integer|real|logical|character|complex|type|class)[^ ]* +)*(subroutine|function) +[a-z0-9_]+/) {
        t = s
        sub(/.*(subroutine|function) +/, "", t)
        sub(/[^a-z0-9_].*/, "", t)
        decl[1] = t
        return 1
    }
    if (s ~ /^(abstract )?interface [a-z0-9_]+/) {
        t = s
        sub(/^(abstract )?interface /, "", t)
        sub(/[^a-z0-9_].*/, "", t)
        decl[1] = t
        return 1
    }
    if (s ~ /^type *(,[^:]*)?:: *[a-z0-9_]+/ || s ~ /^type [a-z0-9_]+$/) {
        t = s
        sub(/^type *(,[^:]*)?(:: *| )/, "", t)
        sub(/[^a-z0-9_].*/, "", t)
        decl[1] = t
        return 1
    }
    if (s ~ /^(integer|real|logical|character|complex|type *\(|class *\(|procedure *\()[^!]*::/) {
        t = s
        sub(/^[^:]*:: */, "", t)
        # Drop initial values and array bounds, then split the names.
        gsub(/\([^()]*\)/, "", t)
        gsub(/\([^()]*\)/, "", t)
        gsub(/\[[^]]*\]/, "", t)
        gsub(/=[^,]*/, "", t)
        m = split(t, parts, /,/)
        x = 0
        for (i = 1; i <= m; i++) {
            gsub(/[ *]/, "", parts[i])
            sub(/=>.*/, "", parts[i])
            if (parts[i] ~ /^[a-z0-9_]+$/) decl[++x] = parts[i]
        }
        return x
    }
    return 0
}

function check_doc(    k, s, t, m, i, parts, inmod, depth, iface, nd, nm, pub) {
    delete public_name
    delete public_line
    inmod = 0
    # The public names of the module.
    for (k = 1; k <= nstmts; k++) {
        s = stext[k]
        if (s ~ /^module [a-z0-9_]+$/) inmod = 1
        if (!inmod) continue
        if (s ~ /^contains$/) break
        if (s ~ /^public *::/) {
            t = s
            sub(/^public *:: */, "", t)
            m = split(t, parts, / *, */)
            for (i = 1; i <= m; i++) {
                sub(/^ +/, "", parts[i])
                if (parts[i] ~ /^[a-z0-9_]+$/) {
                    public_name[parts[i]] = 1
                    public_line[parts[i]] = sline[k]
                }
            }
        }
    }
    if (!inmod) return
    # The declarations at module level: the specification part (not
    # inside derived types or interface bodies' insides) and the module
    # procedures.
    depth = 0
    iface = 0
    pub = 0
    inmod = 0
    for (k = 1; k <= nstmts; k++) {
        s = stext[k]
        if (s ~ /^module [a-z0-9_]+$/) {
            inmod = 1
            continue
        }
        if (!inmod) continue
        if (s ~ /^end module/) break
        if (s ~ /^end (subroutine|function|procedure)/) {
            depth--
            continue
        }
        if (s ~ /^end interface/) {
            iface = 0
            continue
        }
        if (s ~ /^end type/) {
            depth--
            continue
        }
        if (depth > 0) {
            if (s ~ /^((recursive|pure|elemental|impure|module) +)*((integer|real|logical|character|type|class)[^ ]* +)*(subroutine|function) /) depth++
            if (s ~ /^type *(,[^:]*)?:: |^type [a-z0-9_]+$/) depth++
            continue
        }
        nd = declared(s)
        for (i = 1; i <= nd; i++) {
            nm = decl[i]
            if (nm in public_name || s ~ /, *public/) {
                if (sdoc[k] !~ /\n[ \t]*!>/ || !last_doc(sdoc[k])) {
                    finding(sline[k], "doc", nm " is public but has no !> comment above its declaration")
                }
                delete public_name[nm]
            }
        }
        if (s ~ /^(abstract )?interface/) {
            iface = 1
            continue
        }
        if (s ~ /^((recursive|pure|elemental|impure|module) +)*((integer|real|logical|character|type|class)[^ ]* +)*(subroutine|function) /) depth++
        if (s ~ /^type *(,[^:]*)?:: |^type [a-z0-9_]+$/) depth++
    }
}

# Whether the comment block DOC ends with a `!>' line, or with `!' lines
# after one (a FORD block may hold plain comment lines).
function last_doc(doc,    m, parts, i) {
    m = split(doc, parts, /\n/)
    for (i = m; i >= 1; i--) {
        if (parts[i] ~ /^[ \t]*!>/) return 1
        if (parts[i] !~ /^[ \t]*!/) return 0
    }
    return 0
}

# ------------------------------------------------------------------
# port
# ------------------------------------------------------------------

function check_port(    k, s, depth, iface, unit, nm, key, absiface, issub) {
    depth = 0
    iface = 0
    absiface = 0
    issub = 0
    for (k = 1; k <= nstmts; k++) {
        s = stext[k]
        if (s ~ /^submodule/) issub = 1
        if (s ~ /^end (subroutine|function|procedure)/) {
            depth--
            continue
        }
        if (s ~ /^abstract interface/) {
            iface = 1
            absiface = 1
            continue
        }
        if (s ~ /^interface/) {
            iface = 1
            continue
        }
        if (s ~ /^end interface/) {
            iface = 0
            absiface = 0
            continue
        }
        if (s ~ /^((recursive|pure|elemental|impure|module|non_recursive) +)*((integer|real|logical|character|complex|type|class)[^ ]* +)*(subroutine|function) +[a-z0-9_]+/ \
            || s ~ /^module procedure [a-z0-9_]+$/) {
            if (s ~ /^module procedure/) {
                nm = s
                sub(/^module procedure /, "", nm)
            } else {
                nm = s
                sub(/.*(subroutine|function) +/, "", nm)
                sub(/[^a-z0-9_].*/, "", nm)
            }
            if (iface) {
                # An interface body: only a separate module procedure's
                # (its documentation is here) is checked, not an abstract
                # interface's nor a generic interface's `module procedure`
                # list of its specific procedures.
                if (!absiface && s !~ /^module procedure/ && separate_module_procedure(s)) port_needed(k, nm)
                if (s !~ /^module procedure/) depth++
                continue
            }
            if (depth == 0 && !(issub && separate_module_procedure(s))) port_needed(k, nm)
            if (s !~ /^module procedure/ || !iface) depth++
            continue
        }
    }
}

# Whether S declares a separate module procedure: `module procedure NAME`,
# or `module` among the prefixes of a subroutine or function
# (`recursive module subroutine`).
function separate_module_procedure(s,    p) {
    if (s ~ /^module procedure/) return 1
    p = s
    sub(/(subroutine|function) .*/, "", p)
    return p ~ /(^| )module( |$)/
}

function port_needed(k, nm,    key) {
    if (nm ~ /^cmd_/) return
    if (sdoc[k] ~ /Port of[ \t\n]|Not a port/) return
    key = file ":" nm
    if (key in allowed) {
        used[key] = 1
        return
    }
    finding(sline[k], "port", nm " says neither \"Port of ...\" nor \"Not a port\"")
}
