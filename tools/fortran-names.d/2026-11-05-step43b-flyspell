# Verb first (R6-17, R6-40), decided by rule and reported: the verb
# comes from what each one does.  flyspell-word, flyspell-region,
# flyspell-buffer, flyspell-small-region and flyspell-large-region keep
# their names: upstream uses "flyspell" as their verb ("Flyspell text
# between BEG and END").  flyspell-sort, flyspell-check-changes and
# flyspell-deplacement-commands have no entry: their names are a run of
# flyspell-sort-corrections and the options flyspell-check-changes and
# flyspell-deplacement-commands, which keep theirs (the functions are
# sort_flyspell_corrections, check_flyspell_changes and
# set_flyspell_deplacement_commands, renamed by hand).
name	flyspell_goto_next_error	goto_next_flyspell_error
name	flyspell_auto_correct_word	auto_correct_flyspell_word
name	flyspell_auto_correct_previous_word	auto_correct_previous_flyspell_word
name	flyspell_check_previous_highlighted_word	check_previous_highlighted_flyspell_word
name	flyspell_correct_word_before_point	correct_flyspell_word_before_point
name	flyspell_delay_command	set_flyspell_delayed_command
name	flyspell_delay_commands	set_flyspell_delayed_commands
name	flyspell_deplacement_command	set_flyspell_deplacement_command
# The new name holds the old one, so it has an entry of its own (the
# spellcheck family, 2026-11-05), which also ends the chain.
name	set_flyspell_deplacement_command	set_spellcheck_deplacement_command
name	flyspell_after_change_function	record_flyspell_change
name	flyspell_notify_misspell	notify_flyspell_misspelling
