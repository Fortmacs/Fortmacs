# A top-level definition.
term	defun	subprogram

# A balanced expression.
term	sexp	expression
name	halfsexp	halfexpression
name	sexpflag	expressionflag

# An association list.
term	alist	table
name	compilation_error_regexp_alist_alist	compilation_error_regexp_table
name	compilation_error_regexp_alist	compilation_error_regexp_names

# A list in the sense of a parenthesised group.
name	forward_list	forward_group
name	backward_list	backward_group
name	up_list	up_group
name	down_list	down_group
name	backward_up_list	backward_up_group
name	kill_backward_up_list	kill_backward_up_group
name	scan_lists	scan_groups

# Modules.
file	lisp_cmds_fm	expression_motion_fm

# Awaiting the owner (PORTING.md, "Fortran names for Lisp terms"):
# smie-down-list (a list in the group sense, not in the list above);
keep	smie_down_list
# abbrev-minor-mode-table-alist (would read abbrev_minor_mode_table_table);
keep	abbrev_minor_mode_table_alist
# font-lock-defaults' SYNTAX-ALIST (syntax_table is a syntax table);
keep	syntax_alist
# the display-buffer action alist (display_table_type would be a display
# table, disptab.h);
keep	display_alist_type
# Vbuffer_alist and Vprocess_alist (their modules already have a `table').
keep	alist	src/buffer_fm.f90 src/buffer_ops_fm.f90 src/process_fm.f90
keep	alist_count	src/buffer_fm.f90 src/buffer_ops_fm.f90 src/process_fm.f90

# Lisp that stays Lisp.
# The commands of upstream's run-time Lisp evaluation, which test_bindings_fm
# checks do not exist (not applicable, like the Lisp modes' own commands).
keep	eval_last_sexp
keep	eval_defun
# Lisp source as buffer text in tests (test_paren_fm, test_simple_electric_fm,
# test_expression_motion_fm).
keep	"(defun "
keep	";; Comment before a defun"
# The upstream text tools/gen-tty-colors.sh looks for in tty-colors.el.
keep	"An alist of X color names"
# It counts upstream's C DEFUNs and Lisp (defun ...) forms.
keep	tools/progress.sh
# The Lisp language modes (lisp-mode.el, elisp-mode.el, scheme.el; not yet
# ported): their keywords, regexps and fixtures are Lisp source.
keep	src/lisp_mode_fm.f90
keep	src/elisp_mode_fm.f90
keep	src/scheme_fm.f90
keep	test/test_lisp_mode_fm.f90
keep	test/test_elisp_mode_fm.f90
keep	test/test_scheme_fm.f90
# Upstream's C macro (DEFUN, DEFUNs), not a Lisp term.
keep	"DEFUN"
# Lisp source quoted in comments: the regexp of `occur's example, which
# collects the function names in a Lisp program, and window.el code.
keep	"defun\s +\(\S +\)"
keep	"(selected-window) alist)"
# f90_fm's adapters of f90-beginning-of-subprogram and f90-end-of-subprogram
# to beginning_of_subprogram_function and end_of_subprogram_function: their
# Fortran names would be those of the f90.el commands they adapt.
keep	f90_beginning_of_defun	src/f90_fm.f90
keep	f90_end_of_defun	src/f90_fm.f90
